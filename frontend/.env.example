# Copy to .env.local

# FastAPI API root
# Local: http://localhost:3000 → backend http://localhost:8000/api
# LAN:   http://YOUR_LAN_IP:8000/api  (must match backend CORS_ORIGINS)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Campus name stored on registration (users do not type school)
NEXT_PUBLIC_CAMPUS_NAME=本校
