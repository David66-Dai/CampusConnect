# Copy to .env and adjust for your environment

# ===== Basics =====
ENVIRONMENT=development
# JWT signing key — MUST replace in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# ===== Database =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campusconnect

# ===== CORS =====
# Comma-separated origins
# LAN example: CORS_ORIGINS=http://localhost:3000,http://192.168.x.x:3000
CORS_ORIGINS=http://localhost:3000

# Frontend origin (used in password-reset email links)
FRONTEND_URL=http://localhost:3000

# ===== Email (SMTP) =====
# Leave empty in local dev to get reset links / codes in the API response.
#
# NetEase 163 (recommended in CN):
#   1. 163 mailbox → Settings → POP3/SMTP/IMAP → enable SMTP → get 授权码
#   2. Example:
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USERNAME=you@163.com
# SMTP_PASSWORD=your-authorization-code
# SMTP_FROM=CampusConnect <you@163.com>
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
#
# Gmail (often blocked / proxied): smtp.gmail.com, port 587, TLS=true, SSL=false, App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# ===== Image uploads (Cloudinary) =====
# Required for avatar / product / post images. Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Optional AI (reserved) =====
OPENAI_API_KEY=
GEMINI_API_KEY=
